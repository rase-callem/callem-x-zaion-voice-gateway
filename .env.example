AUDIO_TRANSPORT_PROTOCOL=chan_websocket
HOST=127.0.0.1
PORT=8080
WS_PATH=/media

# Speech credentials (factories also accept explicit per-call configuration)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Google uses Application Default Credentials, e.g. this file path:
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
SONIOX_API_KEY=
SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBSOCKET_URL=wss://streaming.assemblyai.com/v3/ws
KROKO_CLOUD_API_KEY=
GLADIA_API_KEY=
CALLEM_ASR_WEBSOCKET_URL=ws://localhost:8000
VOXYGEN_TOKEN=
GRADIUM_API_KEY=
CARTESIA_API_KEY=
